filters:
  and:
    - 'type == "task"'
properties:
  file.name:
    displayName: Task
views:
  - type: table
    name: Open
    filters:
      and:
        - 'status == "open" || status == "waiting"'
    groupBy:
      property: scope
      direction: ASC
    order: [file.name, area, priority, due, status, waiting]
    sort:
      - property: due
        direction: ASC
  - type: table
    name: Waiting on someone
    filters:
      and:
        - 'status == "waiting"'
    order: [file.name, scope, waiting, added]
  - type: table
    name: Done
    filters:
      and:
        - 'status == "done"'
    order: [file.name, scope, done]
